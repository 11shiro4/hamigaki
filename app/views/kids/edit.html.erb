<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>シャカシャカにっき - プロフィール編集</title>
  <link href="https://fonts.googleapis.com/css2?family=DotGothic16&display=swap" rel="stylesheet"> <!-- フォントの変更 -->
  <style>
    /* リセットCSS */
    * {
      box-sizing: border-box;
    }

    html, body, ul, li, h1, h2, p, div {
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'DotGothic16', sans-serif;
      background: linear-gradient(90deg, #ffebee, #e8f5e9, #fffde7);
      margin: 0;
      padding: 0;
      color: #333;
      display: flex;
      flex-direction: column;
      height: 100vh;
      text-align: center;
      overflow: hidden;
    }

    header {
      background-color: #ffd54f;
      padding: 20px;
      width: 100%;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      flex-shrink: 0;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    header h1 {
      margin: 0;
      font-size: 2.0rem;
      color: #fff;
    }

    main {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      flex-grow: 1;
      padding: 20px;
      text-align: center;
      max-width: 800px;
      margin: 0 auto;
      margin-top: 80px;
    }

    .form-container {
      position: relative;
    }

    .field {
      margin-bottom: 15px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .field label {
      width: 150px;
      text-align: center;
      margin-right: 10px;
    }

    .field input {
      width: calc(100% - 160px);
      text-align: center;
      font-size: 1rem;
      padding: 10px;
      border: 2px solid #90caf9;
      border-radius: 5px;
      margin-bottom: 10px;
    }

    .actions {
      margin-top: 20px;
    }

    .btn-primary {
      background: #ff69b4;
      border: none;
      border-radius: 20px;
      padding: 10px 20px;
      font-size: 1.2rem;
      color: white;
      cursor: pointer;
      text-shadow: 1px 1px 2px #555;
      transition: background 0.3s, transform 0.3s ease;
    }

    .btn-primary:hover {
      background-color: #ff85c2;
      transform: scale(1.1);
    }

    footer {
      background-color: #ffd54f;
      text-align: center;
      padding: 10px;
      color: white;
      flex-shrink: 0;
      position: fixed;
      bottom: 0;
      width: 100%;
    }

    /* アニメーション */
    @keyframes walk {
      0% { transform: translateX(0) translateY(0); }
      25% { transform: translateX(25px) translateY(-5px); }
      50% { transform: translateX(50px) translateY(0); }
      75% { transform: translateX(75px) translateY(-5px); }
      100% { transform: translateX(100px) translateY(0); }
    }

    .walking-image {
      position: absolute;
      top: -60px;
      left: 50%;
      transform: translateX(-50%);
      width: 50px;
      height: 50px;
      animation: walk 2s infinite linear;
    }
  </style>
</head>
<body>
  <header>
      <h1>プロフィール編集</h1>
  </header>

  <main>
    <div class="form-container">
      <img src="<%= asset_path('dentist-day.png') %>" alt="歩く画像" class="walking-image">
      <%= form_with(model: @kid, local: true) do |form| %>
        <% if @kid.errors.any? %>
          <div id="error_explanation">
            <h2><%= pluralize(@kid.errors.count, "エラー") %> が発生しました:</h2>
            <ul>
            <% @kid.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
            </ul>
          </div>
        <% end %>

        <div class="field">
          <%= form.label :nickname, "ニックネーム" %>
          <%= form.text_field :nickname %>
        </div>

        <div class="field">
          <%= form.label :email, "メールアドレス" %>
          <%= form.email_field :email %>
        </div>

        <div class="field">
          <%= form.label :age, "年齢" %>
          <%= form.number_field :age %>
        </div>

        <div class="actions">
          <%= form.submit "OK", class: "btn-primary" %>
        </div>
      <% end %>
    </div>
  </main>

  <footer>
    <p>© 2025 シャカシャカにっき All Rights Reserved.</p>
  </footer>
</body>
</html>
